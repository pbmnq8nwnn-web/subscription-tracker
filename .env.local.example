# Neon PostgreSQL 連線字串（從 Neon dashboard 複製 pooled connection string）
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Telegram Bot（沿用原本 .env 的值）
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# 登入密碼（你自己設定，登入頁面輸入這個）
APP_PASSWORD=your_strong_password

# Session 加密金鑰（隨機字串，至少 32 字元）
SESSION_SECRET=your_random_secret_at_least_32_chars_long

# Telegram Webhook 驗證 token（隨機字串，防止假冒請求）
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
